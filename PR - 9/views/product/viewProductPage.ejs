<%- include('../header') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /* --- Core Variables --- */
    :root {
        --row-bg: #191c24; 
        --text-primary: #ffffff;
        --text-secondary: #6c7293;
        --accent-blue: #435ebe;
        --accent-red: #ff4b2b;
        --accent-green: #00d25b;
        --accent-purple: #8f5fe8;
        --accent-orange: #ffab00;
    }

    /* --- Customizing the Default Theme Card --- */
    .custom-dark-card {
        background-color: #2A3038 !important;
        border-radius: 15px !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3) !important;
    }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        width: 100%;
    }

    .card-title-custom {
        color: var(--text-primary);
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
    }

    .card-description-custom {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-top: 5px;
    }

    /* --- Custom Table Styling --- */
    .table-responsive {
        width: 100%;
        overflow-x: auto;
    }

    .custom-table {
        width: 100%;
        min-width: 1400px; /* Increased width because of many columns */
        border-collapse: separate;
        border-spacing: 0 15px;
    }

    .custom-table thead th {
        border: none;
        color: var(--text-secondary);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 1px;
        padding-bottom: 10px;
        padding-left: 15px;
    }

    .custom-table tbody tr {
        background-color: var(--row-bg);
        transition: all 0.3s ease;
        box-shadow: 0 5px 10px rgba(0,0,0,0.1);
    }

    .custom-table tbody tr:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        background-color: #222630;
    }

    .custom-table td {
        padding: 15px;
        vertical-align: middle;
        border: none;
        color: var(--text-primary);
        font-size: 0.9rem;
    }

    .custom-table td:first-child { border-top-left-radius: 12px; border-bottom-left-radius: 12px; }
    .custom-table td:last-child { border-top-right-radius: 12px; border-bottom-right-radius: 12px; }

    /* --- Image Styling --- */
    .product-img-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.1);
        box-shadow: 0 5px 10px rgba(0,0,0,0.3);
        background: #000; 
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* --- Badges & Text --- */
    .serial-badge {
        background: rgba(67, 94, 190, 0.2);
        color: #8da2fb;
        padding: 5px 10px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.8rem;
    }

    .name-text { font-weight: 600; letter-spacing: 0.5px; color: #fff; }

    /* Category Badges */
    .badge-cat {
        background: rgba(143, 95, 232, 0.15); color: #b68ff5;
        padding: 5px 10px; border-radius: 15px; font-size: 0.75rem; font-weight: 500;
    }
    .badge-sub {
        background: rgba(0, 210, 91, 0.15); color: #00ea65;
        padding: 5px 10px; border-radius: 15px; font-size: 0.75rem; font-weight: 500;
    }
    .badge-extra {
        background: rgba(255, 171, 0, 0.15); color: #ffab00;
        padding: 5px 10px; border-radius: 15px; font-size: 0.75rem; font-weight: 500;
    }

    /* Price Styling */
    .old-price {
        color: #8f9ab2;
        text-decoration: line-through;
        font-size: 0.85rem;
    }
    .new-price {
        color: #00ea65;
        font-weight: 700;
        font-size: 1rem;
    }

    /* Stock Badges */
    .stock-good { background: rgba(0, 210, 91, 0.15); color: #00ea65; padding: 5px 10px; border-radius: 8px; font-weight: bold; }
    .stock-low { background: rgba(255, 171, 0, 0.15); color: #ffab00; padding: 5px 10px; border-radius: 8px; font-weight: bold; }
    .stock-out { background: rgba(255, 75, 43, 0.15); color: #ff6b52; padding: 5px 10px; border-radius: 8px; font-weight: bold; }

    /* Description Button */
    .desc-btn {
        background: transparent;
        border: none;
        color: #6c8aff;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0;
        margin-top: 5px;
        cursor: pointer;
    }
    .desc-btn:hover { color: #8da2fb; text-decoration: underline; }

    /* --- Action Buttons --- */
    .action-btn {
        display: inline-flex; align-items: center; justify-content: center;
        width: 32px; height: 32px; border-radius: 8px; color: #fff;
        font-size: 0.85rem; margin-right: 5px; transition: all 0.2s;
        text-decoration: none !important;
    }

    .btn-edit { background: rgba(67, 94, 190, 0.2); color: #6c8aff; }
    .btn-edit:hover { background: var(--accent-blue); color: #fff; }

    .btn-delete { background: rgba(255, 75, 43, 0.1); color: #ff6b52; }
    .btn-delete:hover { background: var(--accent-red); color: #fff; }

    button:focus, a:focus, .action-btn:focus {
        outline: none !important; box-shadow: none !important;
    }
</style>

<div class="main-panel">
    <div class="content-wrapper">
        
        <div class="row">
            <div class="col-12 grid-margin stretch-card mt-4">
                <div class="card custom-dark-card">
                    <div class="card-body p-4">
                        
                        <div class="card-header-custom">
                            <div>
                                <h4 class="card-title-custom">Product Management</h4>
                                <p class="card-description-custom">View and manage all products in the system</p>
                            </div>
                          
                        </div>

                        <div class="table-responsive">
                            <table class="custom-table">
                                <thead>
                                    <tr>
                                        <th width="4%">#</th>
                                        <th width="6%">Image</th>
                                        <th width="12%">Product Name</th>
                                        <th width="9%">Category</th>
                                        <th width="9%">Sub Cat</th>
                                        <th width="9%">Extra Cat</th>
                                        <th width="7%">Old Price</th>
                                        <th width="7%">New Price</th>
                                        <th width="7%">Stock</th>
                                        <th width="20%">Description</th>
                                        <th width="10%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (allProduct && allProduct.length > 0) { %>
                                        <% allProduct.forEach((data, index)=> { %>
                                            <tr>
                                                <td>
                                                    <span class="serial-badge">
                                                        <%= index + 1 < 10 ? '0'+(index+1) : index+1 %>
                                                    </span>
                                                </td>

                                                <td>
                                                    <div class="product-img-wrapper">
                                                        <img src="/<%= data.image %>" alt="Product" class="product-img" onerror="this.src='https://via.placeholder.com/50'">
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="name-text"><%= data.product_name %></span>
                                                </td>

                                                <td><span class="badge-cat"><%= data.category_id.category_name %></span></td>
                                                
                                                <td><span class="badge-sub"><%= data.subcategory_id.subcategory_name %></span></td>
                                                
                                                <td><span class="badge-extra"><%= data.extra_category_id.extra_category_name %></span></td>

                                                <td>
                                                    <span class="old-price">₹<%= data.old_price %></span>
                                                </td>

                                                <td>
                                                    <span class="new-price">₹<%= data.price %></span>
                                                </td>

                                                <td>
                                                    <% if(data.stock > 10) { %>
                                                        <span class="stock-good"><i class="fas fa-check-circle me-1"></i> <%= data.stock %></span>
                                                    <% } else if(data.stock > 0) { %>
                                                        <span class="stock-low"><i class="fas fa-exclamation-circle me-1"></i> <%= data.stock %></span>
                                                    <% } else { %>
                                                        <span class="stock-out"><i class="fas fa-times-circle me-1"></i> Out</span>
                                                    <% } %>
                                                </td>

                                                <td>
                                                    <div style="font-size: 0.85rem; color: #aeb7c6; line-height: 1.4;">
                                                        <span id="short-<%= data._id %>"><%= data.description.substring(0, 30) %>...</span>
                                                        <span id="full-<%= data._id %>" style="display: none;"><%= data.description %></span>
                                                        <br>
                                                        <button class="desc-btn" onclick="toggleDesc('<%= data._id %>')" id="btn-<%= data._id %>">View More</button>
                                                    </div>
                                                </td>

                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <a href="/product/editProductPage/<%= data._id %>" class="action-btn btn-edit" title="Edit">
                                                            <i class="fas fa-pen"></i>
                                                        </a>
                                                        
                                                        <a href="/product/deleteProduct?Id=<%= data._id %>" 
                                                           class="action-btn btn-delete" 
                                                           onclick="return confirm('Are you sure you want to delete this product?')"
                                                           title="Delete">
                                                            <i class="fas fa-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="11" class="text-center py-5">
                                                <div style="color: var(--text-secondary); opacity: 0.7;">
                                                    <i class="fas fa-box-open fa-3x mb-3"></i>
                                                    <p>No Products Found</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
</div>
</div>
</div>
</div>

<%- include('../footer') %>

<script>
    function toggleDesc(productId) {
        const shortDesc = document.getElementById(`short-${productId}`);
        const fullDesc = document.getElementById(`full-${productId}`);
        const btn = document.getElementById(`btn-${productId}`);

        if (fullDesc.style.display === 'none') {
            shortDesc.style.display = 'none';
            fullDesc.style.display = 'inline';
            btn.textContent = 'View Less';
        } else {
            shortDesc.style.display = 'inline';
            fullDesc.style.display = 'none';
            btn.textContent = 'View More';
        }
    }
</script>