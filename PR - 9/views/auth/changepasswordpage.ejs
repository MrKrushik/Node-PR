<%- include("../header") %>

<style>
  /* --- Corona Dark Theme: Blue Edition --- */

  /* Main Card Background */
  .card-corona {
    background-color: #191c24; 
    border-radius: 8px;
    border: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  /* Left Side - Darker shade */
  .info-panel {
    background-color: #0f1015; 
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    position: relative;
    overflow: hidden;
  }

  /* Decorative Blue Line (Changed from Green) */
  .info-panel::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #0090e7; /* Corona Blue */
  }

  /* Input Fields Styling */
  .form-group label {
    color: #6c7293;
    font-size: 0.9rem;
    margin-bottom: 8px;
    display: block;
  }

  .form-control-dark {
    background-color: #2a3038; 
    border: 1px solid #2a3038;
    color: #ffffff;
    height: 45px;
    padding: 10px 15px;
    border-radius: 4px;
    font-size: 0.9rem;
  }

  /* Focus Glow - Blue */
  .form-control-dark:focus {
    background-color: #2a3038;
    border-color: #0090e7; /* Blue Focus Border */
    box-shadow: 0 0 10px rgba(0, 144, 231, 0.2);
    color: #ffffff;
  }

  .input-group-text-dark {
    background-color: #2a3038;
    border: 1px solid #2a3038;
    border-left: none;
    color: #6c7293;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
  }

  .form-control-dark:focus + .input-group-text-dark {
    border-color: #0090e7;
  }

  /* Button Styling - Blue */
  .btn-corona-blue {
    background-color: #0090e7; /* Corona Blue */
    border-color: #0090e7;
    color: #ffffff;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding: 12px;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .btn-corona-blue:hover {
    background-color: #007ac3;
    border-color: #007ac3;
    box-shadow: 0 0 15px rgba(0, 144, 231, 0.4); /* Blue Glow on hover */
  }

  /* Icons & Text */
  .text-blue { color: #0090e7 !important; }
  .text-white { color: #ffffff !important; }
  .text-muted-light { color: #aab2bd !important; }
  
  /* Icon Background */
  .icon-bg {
    width: 60px; 
    height: 60px; 
    background: rgba(0, 144, 231, 0.1); /* Transparent Blue */
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>

<div class="main-panel">
  <div class="content-wrapper">

    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
      <div class="col-lg-10">

        <div class="card card-corona">
          <div class="row g-0">

            <div class="col-md-5 info-panel p-5 d-flex flex-column justify-content-center">
              <div class="mb-4">
                <div class="icon-bg">
                  <i class="mdi mdi-security text-blue" style="font-size: 30px;"></i>
                </div>
              </div>
              <h3 class="text-white fw-bold mb-3">Password Security</h3>
              <p class="text-muted-light" style="line-height: 1.6;">
                Update your password regularly to keep your admin account secure.
              </p>
            </div>

            <div class="col-md-7 p-5">
              <h4 class="card-title text-white mb-4">Change Password</h4>
              
              <form method="post" action="/change-password">

                <div class="form-group mb-4">
                  <label>Current Password</label>
                  <div class="input-group">
                    <input type="password" name="current_password" class="form-control form-control-dark" placeholder="Enter current password" required>
                    <span class="input-group-text input-group-text-dark toggle-pass" style="cursor:pointer">
                      <i class="mdi mdi-eye-off-outline"></i>
                    </span>
                  </div>
                </div>

                <div class="form-group mb-4">
                  <label>New Password</label>
                  <div class="input-group">
                    <input type="password" name="new_password" class="form-control form-control-dark" placeholder="Enter new password" required>
                    <span class="input-group-text input-group-text-dark toggle-pass" style="cursor:pointer">
                      <i class="mdi mdi-eye-off-outline"></i>
                    </span>
                  </div>
                </div>

                <div class="form-group mb-5">
                  <label>Confirm New Password</label>
                  <div class="input-group">
                    <input type="password" name="confirm_password" class="form-control form-control-dark" placeholder="Re-enter new password" required>
                    <span class="input-group-text input-group-text-dark toggle-pass" style="cursor:pointer">
                      <i class="mdi mdi-eye-off-outline"></i>
                    </span>
                  </div>
                </div>

                <button type="submit" class="btn btn-corona-blue w-100">
                  UPDATE PASSWORD
                </button>

              </form>
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>
</div>

<script>
  // Toggle Password Visibility Logic
  document.querySelectorAll(".toggle-pass").forEach(btn => {
    btn.addEventListener("click", function () {
      const input = this.parentElement.querySelector("input");
      const icon = this.querySelector("i");
      
      if (input.type === "password") {
        input.type = "text";
        icon.classList.replace("mdi-eye-off-outline", "mdi-eye-outline");
        icon.style.color = "#0090e7"; // Blue icon when visible
      } else {
        input.type = "password";
        icon.classList.replace("mdi-eye-outline", "mdi-eye-off-outline");
        icon.style.color = ""; // Reset color
      }
    });
  });
</script>

<%- include("../footer") %>