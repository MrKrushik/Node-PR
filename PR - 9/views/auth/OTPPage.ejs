<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTP Verification</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

    <style>
        /* ================= VARIABLES (Corona Dark Blue) ================= */
        :root {
            --primary: #0090e7;
            /* Corona Blue */
            --primary-dark: #007ac3;
            --bg-body: #000000;
            /* Deep Black */
            --bg-card: #191c24;
            /* Card Background */
            --bg-input: #2a3038;
            /* Input Background */
            --text-white: #ffffff;
            --text-muted: #6c7293;
            --border: #2a3038;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            min-height: 100vh;
            background-color: var(--bg-body);
            background-image: linear-gradient(135deg, rgba(0, 144, 231, 0.05) 0%, rgba(0, 0, 0, 0) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        /* CARD */
        .otp-card {
            width: 100%;
            max-width: 450px;
            background: var(--bg-card);
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border-top: 4px solid var(--primary);
            position: relative;
        }

        /* Glow Effect */
        .otp-card::before {
            content: '';
            position: absolute;
            top: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--primary);
            box-shadow: 0 0 20px var(--primary);
            opacity: 0.5;
        }

        /* HEADER */
        .otp-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .otp-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            background: rgba(0, 144, 231, 0.1);
            /* Transparent Blue */
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0, 144, 231, 0.2);
        }

        .otp-icon i {
            color: var(--primary);
            font-size: 32px;
        }

        .otp-header h2 {
            color: var(--text-white);
            margin-bottom: 8px;
            font-weight: 600;
        }

        .otp-header p {
            color: var(--text-muted);
            font-size: 14px;
        }

        /* OTP INPUTS */
        .otp-inputs {
            display: flex;
            justify-content: space-between;
            margin: 30px 0 35px;
            gap: 10px;
        }

        .otp-inputs input {
            width: 100%;
            height: 55px;
            text-align: center;
            font-size: 20px;
            font-weight: 600;
            border-radius: 4px;
            border: 1px solid var(--border);
            background: var(--bg-input);
            color: var(--text-white);
            transition: 0.3s;
        }

        .otp-inputs input:focus {
            outline: none;
            border-color: var(--primary);
            background: var(--bg-input);
            box-shadow: 0 0 10px rgba(0, 144, 231, 0.3);
            transform: translateY(-2px);
        }

        /* BUTTON */
        .verify-btn {
            width: 100%;
            border: none;
            padding: 14px;
            border-radius: 4px;
            background-color: var(--primary);
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
        }

        .verify-btn:hover {
            background-color: var(--primary-dark);
            box-shadow: 0 0 15px rgba(0, 144, 231, 0.4);
            transform: translateY(-2px);
        }

        /* RESEND */
        .resend {
            text-align: center;
            margin-top: 25px;
            font-size: 14px;
            color: var(--text-muted);
        }

        .resend a {
            color: var(--primary);
            font-weight: 500;
            text-decoration: none;
            transition: 0.3s;
        }

        .resend a:hover {
            color: var(--text-white);
            text-decoration: underline;
        }

        /* MOBILE */
        @media(max-width:480px) {
            .otp-card {
                padding: 30px 20px;
            }

            .otp-inputs {
                gap: 5px;
            }

            .otp-inputs input {
                height: 50px;
                font-size: 18px;
            }
        }
    </style>
</head>

<body>

    <div class="otp-card">
        <div class="otp-header">
            <div class="otp-icon">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h2>OTP Verification</h2>
            <p>Enter the 6-digit code sent to your email.</p>
        </div>

        <form method="post" action="/otpverify">
            <div class="otp-inputs">
                <input type="text" maxlength="1" inputmode="numeric">
                <input type="text" maxlength="1" inputmode="numeric">
                <input type="text" maxlength="1" inputmode="numeric">
                <input type="text" maxlength="1" inputmode="numeric">
                <input type="text" maxlength="1" inputmode="numeric">
                <input type="text" maxlength="1" inputmode="numeric">
            </div>

            <input type="hidden" name="adminOTP" id="otpValue">

            <button class="verify-btn">Verify OTP</button>
        </form>

        <div class="resend">
            Didn’t receive OTP?
            <a href="/resend-otp">Resend Code</a>
        </div>
    </div>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        const inputs = document.querySelectorAll(".otp-inputs input");
        const otpHidden = document.getElementById("otpValue");

        inputs.forEach((input, index) => {
            input.addEventListener("input", () => {
                // Allow only numbers
                input.value = input.value.replace(/[^0-9]/g, "");

                // Move to next input
                if (input.value && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
                updateOtp();
            });

            input.addEventListener("keydown", e => {
                // Move to previous input on Backspace
                if (e.key === "Backspace" && !input.value && index > 0) {
                    inputs[index - 1].focus();
                }
            });

            // Handle Paste Event
            input.addEventListener("paste", (e) => {
                e.preventDefault();
                const pasteData = e.clipboardData.getData("text").replace(/[^0-9]/g, "").slice(0, 6);

                if (pasteData) {
                    pasteData.split("").forEach((char, i) => {
                        if (inputs[i]) inputs[i].value = char;
                    });
                    updateOtp();
                    // Focus last filled input
                    const lastIndex = Math.min(pasteData.length, inputs.length) - 1;
                    inputs[lastIndex].focus();
                }
            });
        });

        function updateOtp() {
            otpHidden.value = [...inputs].map(i => i.value).join("");
        }
    </script>


<script>
    <% if(typeof flash !== 'undefined' && flash.error && flash.error.length > 0) { %>
        Toastify({
            text: "<%= flash.error %>",
            duration: 3000,
            gravity: "top",
            position: "center",
            close: true,
            style: {
                background: "linear-gradient(135deg, #ef4444, #991b1b)",
                borderRadius: "10px"
            }
        }).showToast();
    <% } %>
</script>
    
</body>

</html>