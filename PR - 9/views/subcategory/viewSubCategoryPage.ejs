<%- include('../header') %>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    /* --- Core Variables --- */
    :root {
        --row-bg: #191c24; 
        --text-primary: #ffffff;
        --text-secondary: #6c7293;
        --accent-blue: #435ebe;
        --accent-red: #ff4b2b;
        --accent-purple: #8f5fe8;
    }

    /* --- Customizing the Default Theme Card --- */
    .custom-dark-card {
        background-color: #2A3038 !important;
        border-radius: 15px !important;
        border: 1px solid rgba(255, 255, 255, 0.05) !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3) !important;
    }

    .card-header-custom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        width: 100%;
    }

    .card-title-custom {
        color: var(--text-primary);
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
    }

    .card-description-custom {
        color: var(--text-secondary);
        font-size: 0.9rem;
        margin-top: 5px;
    }

    /* --- Table Styling (No Scrollbar Issue) --- */
    .table-responsive {
        width: 100%;
        overflow-x: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
    }
    .table-responsive::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 15px;
    }

    .custom-table thead th {
        border: none;
        color: var(--text-secondary);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 1px;
        padding-bottom: 10px;
        padding-left: 15px;
    }

    .custom-table tbody tr {
        background-color: var(--row-bg);
        transition: all 0.3s ease;
        box-shadow: 0 5px 10px rgba(0,0,0,0.1);
    }

    .custom-table tbody tr:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        background-color: #222630;
    }

    .custom-table td {
        padding: 15px;
        vertical-align: middle;
        border: none;
        color: var(--text-primary);
        font-size: 0.95rem;
    }

    .custom-table td:first-child { border-top-left-radius: 12px; border-bottom-left-radius: 12px; }
    .custom-table td:last-child { border-top-right-radius: 12px; border-bottom-right-radius: 12px; }

    /* --- Image Styling --- */
    .cat-img-wrapper {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        overflow: hidden;
        border: 2px solid rgba(255,255,255,0.1);
        box-shadow: 0 5px 10px rgba(0,0,0,0.3);
        background: #000; 
    }

    .cat-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* --- Badges & Text --- */
    .serial-badge {
        background: rgba(67, 94, 190, 0.2);
        color: #8da2fb;
        padding: 5px 10px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .name-text {
        font-weight: 600;
        letter-spacing: 0.5px;
        color: #fff;
    }

    .badge-cat {
        background: rgba(143, 95, 232, 0.15); 
        color: #b68ff5;
        padding: 6px 12px; 
        border-radius: 20px; 
        font-size: 0.8rem; 
        font-weight: 500;
        border: 1px solid rgba(143, 95, 232, 0.3);
    }

    /* --- Action Buttons --- */
    .action-btn {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 8px 15px; border-radius: 8px; color: #fff;
        font-size: 0.85rem; margin-right: 8px; transition: all 0.2s;
        text-decoration: none !important;
    }

    .btn-edit { background: rgba(67, 94, 190, 0.2); color: #6c8aff; }
    .btn-edit:hover { background: var(--accent-blue); color: #fff; }

    .btn-delete { background: rgba(255, 75, 43, 0.1); color: #ff6b52; }
    .btn-delete:hover { background: var(--accent-red); color: #fff; }

    button:focus, a:focus, .action-btn:focus { outline: none !important; box-shadow: none !important; }
</style>

<div class="main-panel">
    <div class="content-wrapper">
        
        <div class="row">
            <div class="col-12 grid-margin stretch-card mt-4">
                <div class="card custom-dark-card">
                    <div class="card-body p-4">
                        
                        <div class="card-header-custom">
                            <div>
                                <h4 class="card-title-custom">Subcategory Management</h4>
                                <p class="card-description-custom">View and manage all subcategories in the system</p>
                            </div>
                           
                        </div>

                        <div class="table-responsive">
                            <table class="custom-table">
                                <thead>
                                    <tr>
                                        <th width="10%">#No</th>
                                        <th width="15%">Category Image</th>
                                        <th width="30%">Subcategory Name</th>
                                        <th width="25%">Parent Category</th>
                                        <th width="20%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (allSubCategory && allSubCategory.length > 0) { %>
                                        <% allSubCategory.forEach((data, index)=> { %>
                                            <tr>
                                                <td>
                                                    <span class="serial-badge">
                                                        <%= index + 1 < 10 ? '0'+(index+1) : index+1 %>
                                                    </span>
                                                </td>

                                                <td>
                                                    <div class="cat-img-wrapper">
                                                        <% if(data.category_id && data.category_id.category_image) { %>
                                                            <img src="/<%= data.category_id.category_image %>" alt="Category" class="cat-img" onerror="this.src='https://via.placeholder.com/50'">
                                                        <% } else { %>
                                                            <img src="https://via.placeholder.com/50?text=No+Img" alt="No Image" class="cat-img">
                                                        <% } %>
                                                    </div>
                                                </td>

                                                <td>
                                                    <span class="name-text"><%= data.subcategory_name %></span>
                                                </td>

                                                <td>
                                                    <span class="badge-cat">
                                                        <i class="fas fa-folder me-1"></i> <%= data.category_id ? data.category_id.category_name : 'No Parent (Deleted)' %>
                                                    </span>
                                                </td>

                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <a href="/subcategory/editSubCategory/<%= data._id %>" class="action-btn btn-edit">
                                                            <i class="fas fa-pen me-1"></i> 
                                                        </a>
                                                        
                                                        <a href="/subcategory/deleteSubCategory?Id=<%= data._id %>" 
                                                           class="action-btn btn-delete" 
                                                           onclick="return confirm('Are you sure you want to delete this subcategory?')">
                                                            <i class="fas fa-trash me-1"></i> 
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-5">
                                                <div style="color: var(--text-secondary); opacity: 0.7;">
                                                    <i class="fas fa-sitemap fa-3x mb-3"></i>
                                                    <p>No Subcategories Found</p>
                                                </div>
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

 </div>
    </div>

<%- include('../footer') %>