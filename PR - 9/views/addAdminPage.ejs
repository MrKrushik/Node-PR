<%- include('header') %>

    <div class="col-12 grid-margin stretch-card mt-5">
        <div class="card ">
            <div class="card-body ">

                <h4 class="card-title">Admin Registration</h4>
                <p class="card-description">Fill all details</p>

                <form class="forms-sample " method="post" action="/insertAdmin" enctype="multipart/form-data">

                    <div class="row  ">

                        <!-- First Name -->
                        <div class="col-md-6 ">
                            <div class="form-group">
                                <label>First Name</label>
                                <input type="text" class="form-control" name="fname" placeholder="First Name">
                            </div>
                        </div>

                        <!-- Last Name -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Last Name</label>
                                <input type="text" class="form-control" name="lname" placeholder="Last Name">
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Email</label>
                                <div class="input-group">
                                    <input type="email" class="form-control" name="email" placeholder="Email">
                                    <span class="input-group-text">@example.com</span>
                                </div>
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Password</label>
                                <input type="password" class="form-control" name="password" placeholder="Password">
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Contact No</label>
                                <input type="text" class="form-control" name="phone" placeholder="Contact Number">
                            </div>
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>City</label>
                                <select class="form-control" name="city">
                                    <option>Select City</option>
                                    <option>Ahmedabad</option>
                                    <option>Surat</option>
                                    <option>Vadodara</option>
                                    <option>Rajkot</option>
                                    <option>Gandhinagar</option>
                                    <option>Bhavnagar</option>
                                    <option>Jamnagar</option>
                                    <option>Junagadh</option>
                                    <option>Anand</option>
                                    <option>Nadiad</option>
                                    <option>Mehsana</option>
                                    <option>Palanpur</option>
                                    <option>Patan</option>
                                    <option>Bharuch</option>
                                    <option>Ankleshwar</option>
                                    <option>Navsari</option>
                                    <option>Valsad</option>
                                    <option>Vapi</option>
                                    <option>Porbandar</option>
                                    <option>Morbi</option>
                                    <option>Surendranagar</option>
                                    <option>Botad</option>
                                    <option>Amreli</option>
                                    <option>Dahod</option>
                                    <option>Godhra</option>
                                    <option>Modasa</option>
                                    <option>Himmatnagar</option>
                                    <option>Kalol</option>
                                    <option>Deesa</option>
                                    <option>Mandvi</option>
                                    <option>Veraval</option>
                                    <option>Somnath</option>
                                    <option>Dwarka</option>

                                </select>
                            </div>
                        </div>

                        <!-- Gender -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Gender</label>
                                <div class="mt-2 ">
                                    <input type="radio" name="gender" value="Male"> Male
                                    <input type="radio" name="gender" value="Female" class="ms-4"> Female
                                </div>
                            </div>
                        </div>

                        <!-- Hobby -->
                        <div class="col-md-6 ">
                            <div class="form-group">
                                <label>Hobby</label>

                                <div class="mt-2" style="display:flex; flex-wrap:wrap; gap:15px;">
                                    <% ["Reading","Playing","Movie","Travelling","Other"].forEach(hobby=>{ %>
                                        <label style="display:flex; align-items:center; gap:5px;">
                                            <input type="checkbox" name="hobby[]" value="<%= hobby %>">
                                            <%= hobby %>
                                        </label>
                                        <% }) %>
                                </div>

                            </div>
                        </div>

                        <!-- Profile Image -->
                        <div class="col-12">
                            <div class="form-group">
                                <label>Profile Image</label>
                                <input type="file" class="form-control" name="profile_image">
                            </div>
                        </div>

                        <!-- About -->
                        <div class="col-12">
                            <div class="form-group">
                                <label>About</label>
                                <textarea class="form-control" name="about" rows="4"></textarea>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-primary me-2">Submit</button>
                            <button type="reset" class="btn btn-dark">Cancel</button>
                        </div>

                    </div>

                </form>

            </div>
     

    <%- include('footer') %>