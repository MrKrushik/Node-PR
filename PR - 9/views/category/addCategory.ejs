<%- include('../header') %>

    <div class="col-12 grid-margin stretch-card mt-5">
        <div class="card ">
            <div class="card-body ">

                <h4 class="card-title">Add Category</h4>
                <p class="card-description">Fill all details</p>

                <form class="forms-sample " method="post" action="/category/addCategory" enctype="multipart/form-data">

                    <div class="row  ">

                        <!-- Category Name -->
                        <div class="col-md-6 ">
                            <div class="form-group">
                                <label>Category Name</label>
                                <input type="text" class="form-control" name="category_name" placeholder="Category Name" required>
                            </div>
                        </div>

                        <!-- Category Image -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Category Image</label>
                                <input type="file" class="form-control" name="category_image" required>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-primary me-2">Add Category</button>
                            <button type="reset" class="btn btn-dark">Cancel</button>
                        </div>

                    </div>

                </form>

            </div>
        </div>
    </div>
     </div>
    </div>

    <%- include('../footer') %>