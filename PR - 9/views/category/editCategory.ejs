<%- include('../header') %>

    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="col-12 grid-margin stretch-card mt-5">
                    <div class="card">
                        <div class="card-body">

                            <h4 class="card-title">Edit Category</h4>
                            <p class="card-description">Update category details</p>

                            <form class="forms-sample" method="post" action="/category/editCategory/<%= category._id %>" enctype="multipart/form-data">

                                <div class="row">

                                    <!-- Category Name -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Category Name</label>
                                            <input type="text" class="form-control" name="category_name" placeholder="Category Name" value="<%= category.category_name %>" required>
                                        </div>
                                    </div>

                                    <!-- Category Image -->
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Category Image</label>
                                            <input type="file" class="form-control" name="category_image">
                                            <% if(category.category_image) { %>
                                                <small class="text-muted">Current: <%= category.category_image %></small>
                                            <% } %>
                                        </div>
                                    </div>

                                    <!-- Buttons -->
                                    <div class="col-12 text-end">
                                        <button type="submit" class="btn btn-primary me-2">Update Category</button>
                                        <button type="reset" class="btn btn-dark">Cancel</button>
                                    </div>

                                </div>

                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
    </div>

    <%- include('../footer') %>