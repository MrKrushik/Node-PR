<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ================= VARIABLES (Corona Dark Blue) ================= */
        :root {
            --primary: #0090e7;
            /* Corona Blue */
            --primary-dark: #007ac3;
            --bg-body: #000000;
            /* Deep Black */
            --bg-card: #191c24;
            /* Card Background */
            --bg-input: #2a3038;
            /* Input Background */
            --text-white: #ffffff;
            --text-muted: #6c7293;
            --border: #2a3038;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            min-height: 100vh;
            background-color: var(--bg-body);
            background-image: linear-gradient(135deg, rgba(0, 144, 231, 0.05) 0%, rgba(0, 0, 0, 0) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        /* ===== LOGIN CARD ===== */
        .login-card {
            width: 100%;
            max-width: 420px;
            background: var(--bg-card);
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border-top: 4px solid var(--primary);
            position: relative;
        }

        /* Glow effect */
        .login-card::before {
            content: '';
            position: absolute;
            top: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--primary);
            box-shadow: 0 0 20px var(--primary);
            opacity: 0.5;
        }

        .login-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .login-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 20px;
            background: rgba(0, 144, 231, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0, 144, 231, 0.2);
        }

        .login-icon i {
            color: var(--primary);
            font-size: 30px;
        }

        .login-header h2 {
            color: var(--text-white);
            font-size: 24px;
            margin-bottom: 6px;
            font-weight: 600;
        }

        .login-header p {
            color: var(--text-muted);
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-label {
            font-size: 14px;
            color: var(--text-muted);
            font-weight: 500;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
        }

        .form-label i {
            margin-right: 8px;
            color: var(--primary);
        }

        .input-group {
            position: relative;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            padding-right: 45px;
            border-radius: 4px;
            border: 1px solid var(--border);
            background: var(--bg-input);
            font-size: 15px;
            color: var(--text-white);
            transition: 0.3s;
            height: 50px;
        }

        .form-control::placeholder {
            color: #495057;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            background: var(--bg-input);
            box-shadow: 0 0 10px rgba(0, 144, 231, 0.2);
        }

        .toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--text-muted);
            transition: 0.3s;
        }

        .toggle:hover {
            color: var(--primary);
        }

        .login-btn {
            width: 100%;
            border: none;
            padding: 14px;
            border-radius: 4px;
            background-color: var(--primary);
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-btn i {
            margin-right: 8px;
        }

        .login-btn:hover {
            background-color: var(--primary-dark);
            box-shadow: 0 0 15px rgba(0, 144, 231, 0.4);
            transform: translateY(-2px);
        }

        .extra-links {
            text-align: center;
            margin-top: 25px;
        }

        .extra-links a {
            color: var(--primary);
            font-size: 14px;
            text-decoration: none;
            font-weight: 500;
            transition: 0.3s;
        }

        .extra-links a:hover {
            color: var(--text-white);
            text-decoration: none;
        }

        /* ===== FORGOT PASSWORD MODAL (Dark) ===== */
        .forgot-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            /* Darker overlay */
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 999;
            backdrop-filter: blur(5px);
        }

        .forgot-card {
            width: 100%;
            max-width: 380px;
            background: var(--bg-card);
            /* Dark Background */
            border-radius: 8px;
            padding: 30px;
            position: relative;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
            animation: fadeUp 0.3s ease;
            border: 1px solid var(--border);
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .forgot-header {
            text-align: center;
            margin-bottom: 20px;
        }

        .forgot-header h3 {
            color: var(--text-white);
            margin-bottom: 6px;
        }

        .forgot-header p {
            font-size: 14px;
            color: var(--text-muted);
        }

        .close-btn {
            position: absolute;
            right: 15px;
            top: 15px;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 20px;
            transition: 0.3s;
        }

        .close-btn:hover {
            color: var(--text-white);
        }

        @media (max-width: 480px) {
            .login-card {
                padding: 30px 20px;
            }
        }
    </style>
</head>

<body>

    <div class="login-card">
        <div class="login-header">
            <div class="login-icon">
                <i class="fas fa-user-shield"></i>
            </div>
            <h2>Admin Login</h2>
            <p>Sign in to access your dashboard</p>
        </div>

        <form method="post" action="/login">
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-envelope"></i>Email Address
                </label>
                <input type="email" name="email" class="form-control" placeholder="Enter your email" required>
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-lock"></i>Password
                </label>
                <div class="input-group">
                    <input type="password" name="password" id="password" class="form-control"
                        placeholder="Enter your password" required>
                    <i class="fas fa-eye toggle" onclick="togglePassword(this)"></i>
                </div>
            </div>

            <button type="submit" class="login-btn">
                <i class="fas fa-sign-in-alt"></i> Login
            </button>
        </form>

        <div class="extra-links">
            <a href="javascript:void(0)" onclick="openForgot()">Forgot password?</a>
        </div>
    </div>

    <div class="forgot-overlay" id="forgotBox">
        <div class="forgot-card">
            <i class="fas fa-times close-btn" onclick="closeForgot()"></i>

            <div class="forgot-header">
                <h3>Forgot Password</h3>
                <p>Enter your registered email address</p>
            </div>

            <form method="post" action="/verify-email">
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-envelope"></i>Email Address
                    </label>
                    <input type="email" name="email" class="form-control" placeholder="Enter your email" required>
                </div>

                <button type="submit" class="login-btn">
                    <i class="fas fa-paper-plane"></i> Send Reset Link
                </button>
            </form>
        </div>
    </div>

    <script>
        function togglePassword(icon) {
            const pass = document.getElementById("password");
            if (pass.type === "password") {
                pass.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
                icon.style.color = "#0090e7";
            } else {
                pass.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
                icon.style.color = "";
            }
        }

        function openForgot() {
            document.getElementById("forgotBox").style.display = "flex";
        }

        function closeForgot() {
            document.getElementById("forgotBox").style.display = "none";
        }
    </script>

</body>

</html>