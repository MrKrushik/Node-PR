<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ================= VARIABLES (Corona Dark Blue) ================= */
        :root {
            --primary: #0090e7;        /* Corona Blue */
            --primary-dark: #007ac3;
            --bg-body: #000000;        /* Deep Black Background */
            --bg-card: #191c24;        /* Card Background */
            --bg-input: #2a3038;       /* Input Background */
            --text-white: #ffffff;
            --text-muted: #6c7293;
            --border: #2a3038;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            min-height: 100vh;
            background-color: var(--bg-body);
            background-image: linear-gradient(135deg, rgba(0, 144, 231, 0.05) 0%, rgba(0, 0, 0, 0) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .reset-card {
            width: 100%;
            max-width: 450px;
            background: var(--bg-card);
            border-radius: 8px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border-top: 4px solid var(--primary); /* Blue Top Border */
            position: relative;
        }

        /* Decorative Glow behind the card */
        .reset-card::before {
            content: '';
            position: absolute;
            top: -2px;
            left: 0;
            right: 0;
            height: 2px;
            background: var(--primary);
            box-shadow: 0 0 20px var(--primary);
            opacity: 0.5;
        }

        .reset-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .reset-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            background: rgba(0, 144, 231, 0.1); /* Transparent Blue */
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0, 144, 231, 0.2);
        }

        .reset-icon i {
            color: var(--primary);
            font-size: 32px;
        }

        .reset-header h2 {
            color: var(--text-white);
            margin-bottom: 8px;
            font-weight: 600;
        }

        .reset-header p {
            font-size: 14px;
            color: var(--text-muted);
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-label {
            font-size: 14px;
            color: var(--text-muted);
            font-weight: 500;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
        }

        .form-label i {
            margin-right: 8px;
            color: var(--primary);
            font-size: 12px;
        }

        .input-group {
            position: relative;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            padding-right: 45px;
            border-radius: 4px;
            border: 1px solid var(--border);
            background: var(--bg-input);
            font-size: 15px;
            color: var(--text-white);
            transition: 0.3s;
            height: 50px;
        }

        .form-control::placeholder {
            color: #495057;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            background: var(--bg-input);
            box-shadow: 0 0 10px rgba(0, 144, 231, 0.2);
        }

        .toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--text-muted);
            transition: 0.3s;
        }

        .toggle:hover {
            color: var(--primary);
        }

        .reset-btn {
            width: 100%;
            border: none;
            padding: 14px;
            border-radius: 4px;
            background-color: var(--primary);
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }

        .reset-btn:hover {
            background-color: var(--primary-dark);
            box-shadow: 0 0 15px rgba(0, 144, 231, 0.4);
            transform: translateY(-2px);
        }

        @media (max-width: 480px) {
            .reset-card {
                padding: 30px 20px;
            }
        }
    </style>
</head>

<body>

    <div class="reset-card">
        <div class="reset-header">
            <div class="reset-icon">
                <i class="fas fa-key"></i>
            </div>
            <h2>Create New Password</h2>
            <p>Your new password must be different from previous used passwords.</p>
        </div>

        <form method="post" action="/changeNewPassword">
            
            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-lock"></i>New Password
                </label>
                <div class="input-group">
                    <input type="password" name="newPassword" id="newPassword" class="form-control"
                        placeholder="Enter new password" required>
                    <i class="fas fa-eye toggle" onclick="toggleNew(this)"></i>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="fas fa-check-circle"></i>Confirm Password
                </label>
                <div class="input-group">
                    <input type="password" name="confirmPassword" id="confirmPassword" class="form-control"
                        placeholder="Confirm new password" required>
                    <i class="fas fa-eye toggle" onclick="toggleConfirm(this)"></i>
                </div>
            </div>

            <button type="submit" class="reset-btn">
                Update Password
            </button>
        </form>
    </div>

    <script>
        function toggleNew(icon) {
            const input = document.getElementById("newPassword");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
                icon.style.color = "#0090e7";
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
                icon.style.color = "";
            }
        }

        function toggleConfirm(icon) {
            const input = document.getElementById("confirmPassword");
            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
                icon.style.color = "#0090e7";
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
                icon.style.color = "";
            }
        }
    </script>

</body>

</html>