<%- include('header') %>

    <div class="col-12 grid-margin stretch-card mt-5">
        <div class="card">
            <div class="card-body">

                <h4 class="card-title">Edit Admin</h4>
                <p class="card-description">Update admin details</p>

                <form class="forms-sample" method="post" action="/editAdmin/<%= singleAdmin.id %>"
                    enctype="multipart/form-data">

                    <div class="row">

                        <!-- First Name -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>First Name</label>
                                <input type="text" class="form-control" name="fname" value="<%= singleAdmin.fname %>">
                            </div>
                        </div>

                        <!-- Last Name -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Last Name</label>
                                <input type="text" class="form-control" name="lname" value="<%= singleAdmin.lname %>">
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Email</label>
                                <div class="input-group">
                                    <input type="email" class="form-control" name="email"
                                        value="<%= singleAdmin.email %>">
                                    <span class="input-group-text">@example.com</span>
                                </div>
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Password</label>
                                <input type="password" class="form-control" name="password"
                                    value="<%= singleAdmin.password %>">
                            </div>
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Contact No</label>
                                <input type="text" class="form-control" name="phone" value="<%= singleAdmin.phone %>">
                            </div>
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>City</label>
                                <select class="form-control" name="city">
                                    <% ["Surat","Baroda","Navsari","Rajkot","Mumbai"].forEach(city=>{ %>
                                        <option value="<%= city %>" <% if(singleAdmin.city===city){ %> selected <% } %>>
                                                <%= city %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                        </div>

                        <!-- Gender -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Gender</label>
                                <div class="mt-2">
                                    <input type="radio" name="gender" value="Male" <% if(singleAdmin.gender==='Male' ){
                                        %> checked <% } %>> Male

                                        <input type="radio" name="gender" value="Female" class="ms-3" <%
                                            if(singleAdmin.gender==='Female' ){ %> checked <% } %>> Female
                                </div>
                            </div>
                        </div>

                        <!-- Hobby -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Hobby</label>
                                <div class="mt-2">
                                    <% ["Reading","Playing","movie","travelling","Other"].forEach(hobby=>{ %>
                                        <input type="checkbox" name="hobby[]" value="<%= hobby %>" <%
                                            if(singleAdmin.hobby && singleAdmin.hobby.includes(hobby)){ %> checked <% }
                                            %>>
                                            <%= hobby %>
                                                <% }) %>
                                </div>
                            </div>
                        </div>

                        <!-- Profile Image -->
                        <div class="col-12">
                            <div class="form-group">
                                <label>Profile Image</label><br>

                                <% if(singleAdmin.profile_image){ %>
                                    <img src="../<%= singleAdmin.profile_image %>" height="60" class="mb-2 rounded">
                                    <% } %>

                                        <input type="file" name="profile_image" class="form-control">
                            </div>
                        </div>

                        <!-- About -->
                        <div class="col-12">
                            <div class="form-group">
                                <label>About</label>
                                <textarea class="form-control" name="about" rows="4">
                                <%= singleAdmin.about %>
                            </textarea>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="col-12 text-end">
                            <button type="submit" class="btn btn-success me-2">Update</button>
                            <a href="/viewAdminPage" class="btn btn-dark">Cancel</a>
                        </div>

                    </div>

                </form>

            </div>
        </div>
    </div>

    <%- include('footer') %>